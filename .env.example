RUNRAIL_HOME=.runrail
# RUNRAIL_DB_URL=postgresql+psycopg://runrail:runrail@localhost/runrail
RUNRAIL_HOST=127.0.0.1
RUNRAIL_PORT=8080
# Limits the local file picker to this directory (defaults to the current user's home).
# RUNRAIL_BROWSE_ROOT=/path/to/projects
# Auto-delete finished runs (and their logs/artifacts) older than this many days.
# Recommended for high-frequency schedules; unset keeps everything forever.
# RUNRAIL_RETENTION_DAYS=30
