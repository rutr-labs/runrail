{# One self-contained document. Rendered with autoescape=True (see
   reports._export_template) because every value below is attacker-influenced:
   task names, rendered commands, error messages, and log text full of
   </script>. Nothing here may reference the network — no stylesheet, script,
   font or image — except the single link back to the live run in the footer. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# The sandbox, frame-ancestors and report-uri directives are IGNORED in a meta
   CSP by spec — only a real header carries them. So the iframe's sandbox
   ATTRIBUTE below is the actual isolation for the embedded report; this meta
   only contributes connect-src, img-src and form-action. #}
{# The same policy the live report is served under, so a notebook that renders
   there (blob images, data fonts, workers) renders here too. #}
<meta http-equiv="Content-Security-Policy" content="{{ report_csp }}">
<title>{{ workflow.name if workflow else 'RunRail' }} · run {{ run.id }}</title>
<style>
:root { color-scheme: light; }
* { box-sizing: border-box; }
body { margin: 0; padding: 32px 24px 64px; background: #f6f7f9; color: #16191d;
  font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 1040px; margin: 0 auto; }
h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em;
  color: #5d6570; margin: 32px 0 10px; }
.card { background: #fff; border: 1px solid #e2e5ea; border-radius: 10px; padding: 18px 20px; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-top: 12px; color: #5d6570; }
.meta b { display: block; font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.06em; font-weight: 600; }
.meta span { color: #16191d; font-variant-numeric: tabular-nums; }
.pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px;
  font-weight: 600; border: 1px solid currentColor; }
.note { margin-top: 14px; padding: 10px 12px; border-radius: 8px; font-size: 13px;
  background: #fff8e6; border: 1px solid #f0dca8; color: #6b5312; }
.task { margin-bottom: 10px; }
.task-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
.task-head strong { font-size: 15px; }
.task-head small { color: #5d6570; font-variant-numeric: tabular-nums; }
code, pre { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace; }
code { background: #f0f2f5; border-radius: 4px; padding: 1px 5px; font-size: 12.5px;
  word-break: break-all; }
pre { background: #14171c; color: #dfe4ea; border-radius: 8px; padding: 12px 14px;
  overflow-x: auto; font-size: 12px; line-height: 1.5; white-space: pre-wrap;
  word-break: break-word; max-height: 520px; overflow-y: auto; }
details { margin-top: 10px; }
summary { cursor: pointer; font-size: 12px; font-weight: 600; color: #5d6570; }
.error { margin-top: 8px; color: #a3231f; font-size: 13px; }
.brandline { display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
             font-weight: 700; letter-spacing: -.2px; color: #3b4252; }
/* `svg { width: 100% }` above exists for the timeline, and a CSS rule beats the
   mark's width/height attributes — so the mark needs its size stated here. */
.brandline svg { width: 22px; height: 22px; flex: none; }
iframe { width: 100%; height: 760px; border: 1px solid #e2e5ea; border-radius: 8px;
  background: #fff; }
footer { margin-top: 40px; color: #5d6570; font-size: 12px; }
footer a { color: #2b5bd7; }
svg { width: 100%; height: auto; }
.rail-label { fill: #5d6570; font-size: 12px; }
.rail-track { fill: #eceff3; }
.rail-bar { opacity: 0.16; }
.s-success { fill: #1f9254; color: #1f9254; }
.s-failed { fill: #c0342f; color: #c0342f; }
.s-skipped, .s-cancelled, .s-queued { fill: #8b93a0; color: #8b93a0; }
.s-running, .s-awaiting_approval, .s-rejected { fill: #b7791f; color: #b7791f; }
.s-approved { fill: #1f9254; color: #1f9254; }
.changes .change-block { margin-bottom: 14px; }
.changes .change-block:last-child { margin-bottom: 0; }
.muted { color: #5d6570; font-size: 13px; }
pre.diff .add { color: #7ee2a8; } pre.diff .del { color: #ff9b95; } pre.diff .hunk { color: #8ab4ff; }
@media print { body { background: #fff; } .card { break-inside: avoid; } pre { max-height: none; } }
</style>
</head>
<body>
<main>

<div class="card">
  {# Inlined, like everything else in this file: it opens from an email with
     nothing loaded from the network. Ink is currentColor so it survives a
     reader that forces its own colours. #}
  <div class="brandline">
    <svg viewBox="0 0 64 64" width="22" height="22" fill="none" aria-hidden="true">
      <path d="M 14 58 V 30 C 14 19, 24 12, 36 12 H 58" stroke="currentColor" stroke-width="6"/>
      <path d="M 26 58 V 32 C 26 27, 31 24, 38 24 H 58" stroke="#ec3013" stroke-width="6"/>
    </svg>
    <span>RunRail</span>
  </div>
  <h1>{{ workflow.name if workflow else 'Deleted workflow' }}</h1>
  <div>Run #{{ run.id }} <span class="pill s-{{ run.status.value }}">{{ run.status.value }}</span></div>
  <div class="meta">
    <div><b>Trigger</b><span>{{ run.trigger_type.value }}</span></div>
    <div><b>Started</b><span>{{ started }}</span></div>
    <div><b>Finished</b><span>{{ finished }}</span></div>
    <div><b>Duration</b><span>{{ duration }}</span></div>
    <div><b>Tasks</b><span>{{ task_runs | length }}</span></div>
  </div>
  <div class="note">Exported {{ exported_at }} — this is a snapshot, not a live view.</div>
</div>

{% if timeline.rows %}
<h2>Timeline</h2>
<div class="card">
  <svg viewBox="0 0 1000 {{ timeline.height }}" role="img" aria-label="Task timeline">
    {% for row in timeline.rows %}
    <text class="rail-label" x="0" y="{{ row.y + 4 }}">{{ row.label }}</text>
    <rect class="rail-track" x="260" y="{{ row.y - 5 }}" width="720" height="10" rx="5"></rect>
    <rect class="rail-bar s-{{ row.status }}" x="{{ row.x }}" y="{{ row.y - 5 }}"
          width="{{ row.width }}" height="10" rx="5"></rect>
    {% for dot in row.dots %}
    <circle class="s-{{ row.status }}" cx="{{ dot }}" cy="{{ row.y }}" r="2"></circle>
    {% endfor %}
    {% endfor %}
  </svg>
</div>
{% endif %}

{% if changes and changes.baseline %}
<h2>What changed since run #{{ changes.baseline.id }}, the last that succeeded</h2>
<div class="card changes">
  {% if changes.parameters %}
  <div class="change-block"><b>Parameters</b>
    {% for p in changes.parameters %}<div><code>{{ p.name }}</code>
      {{ p.before if p.change != 'added' else '—' }} → {{ p.after if p.change != 'removed' else '—' }}</div>{% endfor %}
  </div>
  {% endif %}
  {% set ns = namespace(any=changes.parameters|length > 0) %}
  {% for task in changes.tasks or [] %}
  {% set logs = task.logs or {} %}
  {% if task.code or task.environment or task.command or logs.new_total or logs.changed_total
        or (task.before and task.after and task.before.status != task.after.status) %}
  {% set ns.any = true %}
  <div class="change-block"><b>{{ task.name }}</b>
    <span class="muted">{{ task.before.status if task.before else 'not run' }} → {{ task.after.status if task.after else 'not run' }}</span>
    {% if task.code %}
    {% for f in task.code.files %}
    <details{{ ' open' if f.used else '' }}><summary>{{ f.path }} {{ f.change }}{{ '' if f.used else ' (not used by this task)' }}</summary>
      {% if f.diff %}<pre class="diff">{% for line in f.diff[2:] %}<span class="{{ 'add' if line.startswith('+') else 'del' if line.startswith('-') else 'hunk' if line.startswith('@@') else '' }}">{{ line }}
</span>{% endfor %}</pre>{% elif f.note %}<div class="muted">{{ f.note }}</div>{% endif %}
    </details>
    {% endfor %}
    {% endif %}
    {% if task.environment and task.environment.packages %}
    <div class="muted">Packages: {% for p in task.environment.packages %}{{ p.name }} {{ (p.before or '—').split('==')[-1] }} → {{ (p.after or '—').split('==')[-1] }}{{ ', ' if not loop.last }}{% endfor %}</div>
    {% endif %}
    {% if task.command %}<pre class="diff"><span class="del">- {{ task.command.before }}
</span><span class="add">+ {{ task.command.after }}</span></pre>{% endif %}
    {% if logs.changed or logs.new %}
    <pre class="diff">{% for c in logs.changed[:15] %}<span class="del">- {{ c.before }}
</span><span class="add">+ {{ c.after }}
</span>{% endfor %}{% for l in logs.new[:30] %}<span class="add">+ {{ l.text }}
</span>{% endfor %}</pre>
    {% endif %}
  </div>
  {% endif %}
  {% endfor %}
  {% if not ns.any %}<div class="muted">Nothing differs in parameters, code, packages or logs: the cause is likely outside RunRail.</div>{% endif %}
</div>
{% endif %}

<h2>Tasks</h2>
{% for task_run in task_runs %}
<div class="card task">
  <div class="task-head">
    <strong>{{ task_run.task_name or 'task ' ~ task_run.task_id }}</strong>
    <span class="pill s-{{ task_run.status.value }}">{{ task_run.status.value }}</span>
    <small>{{ task_run.task_type or '—' }} · attempt {{ task_run.attempt }} ·
      exit {{ task_run.exit_code if task_run.exit_code is not none else '—' }} ·
      {{ fmt_duration(task_run.duration_seconds) }} · {{ stamp(task_run.started_at) }}</small>
  </div>
  {% if task_run.rendered_command %}
  <div style="margin-top:8px"><code>{{ task_run.rendered_command }}</code></div>
  {% endif %}
  {% if task_run.error_message %}
  <div class="error">{{ task_run.error_message }}</div>
  {% endif %}
  {% for stream, text in (sections.get(task_run.id) or {}).items() %}
  <details{{ ' open' if task_run.status.value == 'failed' and stream == 'stderr' else '' }}>
    <summary>{{ stream }}</summary>
    <pre>{{ text }}</pre>
  </details>
  {% endfor %}
</div>
{% endfor %}

{% if report_html %}
<h2>Report</h2>
{# sandbox WITHOUT allow-same-origin: this file opens as file:// on someone
   else's machine, and an opaque origin is what stops the notebook's scripts
   reading their local files. Adding allow-same-origin here disables the
   sandbox entirely. #}
<iframe sandbox="allow-scripts" referrerpolicy="no-referrer" title="Notebook report"
        srcdoc="{{ report_html }}"></iframe>
{% elif report_note %}
<h2>Report</h2>
<div class="card"><div class="note">{{ report_note }}</div></div>
{% endif %}

<footer>
  Exported from RunRail {{ version }}.
  {% if run_url_reachable %}
  The original run is at <a href="{{ run_url }}">{{ run_url }}</a>, which only resolves from inside that network.
  {% else %}
  The original run is run {{ run.id }} on the machine this was exported from (it has no public URL configured).
  {% endif %}
</footer>

</main>
</body>
</html>
